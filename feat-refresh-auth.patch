diff --git a/src/transport/middleware/requireAuth.ts b/src/transport/middleware/requireAuth.ts
new file mode 100644
index 0000000..5858283
--- /dev/null
+++ b/src/transport/middleware/requireAuth.ts
@@ -0,0 +1,23 @@
+import type { NextFunction, Request, RequestHandler, Response } from "express";
+import type { TokenService } from "../../services/types/token.js";
+
+export const createRequireAuth = (tokenService: TokenService): RequestHandler => {
+  return (req: Request, res: Response, next: NextFunction) => {
+    const token = req.cookies?.accessToken;
+
+    if (typeof token !== "string") {
+      res.status(401).json({ message: "Access token is missing" });
+      return;
+    }
+
+    const userId = tokenService.verifyAccessToken(token);
+
+    if (userId === null) {
+      res.status(401).json({ message: "Invalid access token" });
+      return;
+    }
+
+    res.locals.userId = userId;
+    next();
+  };
+};
diff --git a/src/utils/password.ts b/src/utils/password.ts
new file mode 100644
index 0000000..9103009
--- /dev/null
+++ b/src/utils/password.ts
@@ -0,0 +1,17 @@
+import { randomBytes, scryptSync, timingSafeEqual } from "node:crypto";
+
+export const hashPassword = (password: string): string => {
+  const salt = randomBytes(16).toString("hex");
+  const hash = scryptSync(password, salt, 64).toString("hex");
+  return salt + ":" + hash;
+};
+
+export const verifyPassword = (password: string, saved: string): boolean => {
+  const [salt, hash] = saved.split(":");
+  if (!salt || !hash) {
+    return false;
+  }
+
+  const newHash = scryptSync(password, salt, 64);
+  return timingSafeEqual(Buffer.from(hash, "hex"), newHash);
+};
